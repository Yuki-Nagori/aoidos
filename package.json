{
  "name": "mythos",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run typecheck && bun run build:web",
    "preview": "vite preview",
    "postinstall": "bun scripts/setup.mts",
    "setup": "bun scripts/setup.mts",
    "tauri": "tauri",
    "tauri:build": "tauri build",
    "tauri:dev": "tauri dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:rust": "cargo test --workspace",
    "coverage:rust": "bun scripts/coverage-rust.mts",
    "doc:rust": "RUSTDOCFLAGS=\"-D warnings\" cargo doc --no-deps --workspace",
    "bench": "bun run bench:web",
    "bench:web": "bun src-web/bench/greet.ts",
    "build:web": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:rust": "cargo check --workspace",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:rust": "cargo clippy --workspace --all-targets -- -D warnings",
    "lint:rust:fix": "cargo clippy --fix --workspace --all-targets --allow-dirty && cargo fmt --all",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:rust": "cargo fmt --all",
    "format:rust:check": "cargo fmt --all --check",
    "knip": "knip",
    "verify": "bun run typecheck && bun run typecheck:rust && bun run lint && bun run lint:rust && bun run format:check && bun run format:rust:check && bun run test:coverage && bun run test:rust && bun run coverage:rust && bun run knip && bun run bench && bun run build:web && bun run doc:rust",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "knip": "^6.39.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tinybench": "^6.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "vue": "^3.5.43"
  }
}
